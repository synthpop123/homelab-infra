---
import Changes from "@/components/Changes.astro"
import Field from "@/components/Field.astro"
import PageTitle from "@/components/PageTitle.astro"
import SectionHead from "@/components/SectionHead.astro"
import { NAVIGATION, REPO_URL } from "@/consts"
import Layout from "@/layouts/Layout.astro"
import { catalog } from "@/lib/catalog"
import type { Host, Service } from "../../scripts/catalog"

const { hosts, services } = catalog
/** A count of something per stack, in all and split by host. */
const tally = (count: (service: Service) => number) => ({
  total: services.reduce((n, service) => n + count(service), 0),
  split: (Object.keys(hosts) as Host[])
    .map((host) => {
      const on = services.filter((service) => service.host === host)
      return `${on.reduce((n, service) => n + count(service), 0)} ${host}`
    })
    .join(" · "),
})
const stacks = tally(() => 1)
const containers = tally((service) => service.containers.length)
const endpoints = services
  .filter((service) => !service.stopped)
  .reduce((n, service) => n + service.urls.length, 0)
const cells = Object.values(hosts).flatMap((host) => host.ports)
const used = cells.filter((cell) => cell.stack).length

/** What each page holds, said as one figure at the end of its row. */
const figures: Record<string, string> = {
  "/services": `${services.length} stacks`,
  "/status": `${endpoints} addresses`,
  "/ports": `${used} of ${cells.length} in use`,
  "/flow": "4 lanes",
  "/changes": catalog.commit ? `at ${catalog.commit.slice(0, 7)}` : "the log",
}
const pages = NAVIGATION.filter(({ href }) => href !== "/")
---

<Layout>
  <PageTitle>
    Homelab
    <a slot="aside" href={REPO_URL}>homelab-infra ↗</a>
    <p slot="lead">
      Self-hosted services on two hosts, declared in git and deployed by Komodo:
      merging is deploying. This site is built from the same files and asks each
      service, every minute, whether it still answers.
    </p>
  </PageTitle>

  <dl class="readout">
    <div>
      <dt>Stacks</dt>
      <dd class="value">{stacks.total}</dd>
      <dd>{stacks.split}</dd>
    </div>
    <div>
      <dt>Containers</dt>
      <dd class="value">{containers.total}</dd>
      <dd>{containers.split}</dd>
    </div>
    <div>
      <dt>Answering</dt>
      <dd class="value">
        <span data-live="answering">–</span><small>/{endpoints}</small>
      </dd>
      <dd><time data-live="checked">not asked yet</time></dd>
    </div>
    <div>
      <dt>Median answer</dt>
      <dd class="value"><span data-live="median">–</span><small>ms</small></dd>
      <dd>from Cloudflare’s edge</dd>
    </div>
  </dl>

  <section>
    <SectionHead id="hosts" label="Hosts">
      <a href="/services">All services →</a>
    </SectionHead>
    <Field />
  </section>

  <section>
    <SectionHead id="latest" label="Latest changes">
      <a href="/changes">All changes →</a>
    </SectionHead>
    <Changes />
  </section>

  <section>
    <SectionHead id="pages" label="Inside" />
    <ol class="index">
      {pages.map(({ href, label, blurb }) => (
        <li>
          <a href={href}>
            <b>{label}</b>
            <span>{blurb}</span>
            <small>{figures[href]}</small>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Layout>

<style>
  section {
    margin-block-start: var(--space-xl);
  }

  /* The site's pages as a contents list: a name in the margin column,
     what the page is, and one figure of what it holds. */
  .index {
    border-block-start: var(--hairline) solid var(--border-strong);

    li + li {
      border-block-start: var(--hairline) solid var(--border);
    }

    a {
      display: grid;
      grid-template-columns: var(--host-column) minmax(0, 1fr) auto;
      align-items: baseline;
      column-gap: var(--space-s);
      padding-block: var(--space-xs);
      text-decoration-line: none;
    }

    b {
      font-weight: var(--font-weight-medium);
    }

    span {
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }

    small {
      font-family: var(--font-mono);
      font-feature-settings: normal;
      font-size: var(--step--2);
      letter-spacing: 0;
      color: var(--muted-foreground);
    }

    a:hover :is(span, small) {
      color: var(--foreground);
    }

    @media (width < 30rem) {
      a {
        grid-template-columns: minmax(0, 1fr) auto;
      }

      span {
        grid-row: 2;
        grid-column: 1 / -1;
      }
    }
  }
</style>
