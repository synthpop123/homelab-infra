---
/**
 * The repository's latest commits as a ledger (src/lib/commits.ts): the
 * overview's few. Merging is deploying here, so this is also the deploy
 * log; /changes has the rest of it.
 */
import "@/styles/commits.css"
import { CHANGES } from "@/consts"
---

<lab-changes aria-busy="true">
  <ol class="commits">
    {Array.from({ length: CHANGES.latest }, () => (
      <li data-pending><time>–</time><span></span><code></code></li>
    ))}
  </ol>
</lab-changes>

<script>
  import { CHANGES } from "@/consts"
  import { commitRow, commits, unavailable } from "@/lib/commits"

  const root = document.querySelector<HTMLElement>("lab-changes")
  const list = root?.querySelector("ol")
  if (root && list)
    commits()
      .then((all) =>
        list.replaceChildren(
          ...all.slice(0, CHANGES.latest).map((commit) => commitRow(commit)),
        ),
      )
      .catch(() => {
        const note = unavailable()
        note.className = "commits-note"
        list.replaceWith(note)
      })
      .finally(() => root.setAttribute("aria-busy", "false"))
</script>
