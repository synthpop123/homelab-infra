---
/**
 * Every stack as a ledger, a host to a group: what it is and the version
 * it runs on the left, where it answers on the right, each address with
 * a dot that /api/status fills in (src/lib/status.ts). A name links to
 * the stack's own page, and travels there with it (its view-transition
 * name is the page title's).
 */
import { HOSTS } from "@/consts"
import { catalog } from "@/lib/catalog"
import type { Host } from "../../scripts/catalog"

const { hosts, services } = catalog
const groups = (Object.keys(hosts) as Host[]).map((host) => ({
  host,
  region: hosts[host].region,
  ...HOSTS[host],
  rows: services.filter((service) => service.host === host),
}))
---

<lab-services>
  {groups.map(({ host, region, spec, edge, rows }) => (
    <section>
      <header>
        <h2>{host}</h2>
        <ul>
          {[region, ...spec, edge].map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </header>
      <ol>
        {rows.map((service) => (
          <li
            data-row
            data-host={host}
            data-tags={service.tags.join(" ")}
            data-stack={service.stopped ? undefined : service.name}
            data-stopped={service.stopped || undefined}
            data-search={[
              service.name,
              service.description,
              host,
              ...service.tags,
              ...service.urls,
              ...service.containers.map((container) => container.name),
            ]
              .join(" ")
              .toLowerCase()}
          >
            <div class="what">
              <p>
                <a href={`/services/${service.name}`}>
                  <b style={`view-transition-name: stack-${service.name}`}>
                    {service.name}
                  </b>
                </a>
                {service.version && <code>{service.version}</code>}
                {service.containers.length > 1 && (
                  <small>{service.containers.length} containers</small>
                )}
              </p>
              <p>{service.description}</p>
            </div>
            {service.urls.length > 0 && (
              <ul class="where">
                {service.urls.map((url) => (
                  <li>
                    <a
                      href={url}
                      data-endpoint={service.stopped ? undefined : url}
                    >
                      {new URL(url).host}
                      {!service.stopped && <i data-dot />}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </section>
  ))}
  <p data-empty hidden>No stack matches.</p>
</lab-services>

<style>
  lab-services {
    display: block;
    container-type: inline-size;
  }

  /* A host and its stacks: the host stays in the margin column while its
     rows scroll past, the way a ledger keeps its year. */
  section {
    display: grid;
    grid-template-columns: var(--host-column) minmax(0, 1fr);
    column-gap: var(--space-s);
    border-block-start: var(--hairline) solid var(--border-strong);

    & + section {
      margin-block-start: var(--space-m);
    }
  }

  header {
    position: sticky;
    inset-block-start: var(--page-offset-top);
    align-self: start;
    padding-block: var(--space-xs);

    @media (width < 64rem) {
      inset-block-start: calc(var(--bar-nav-height) + var(--space-2xs));
    }

    h2 {
      font-weight: var(--font-weight-medium);
    }

    ul {
      font-size: var(--step--2);
      line-height: 1.5;
      color: var(--muted-foreground);
    }
  }

  [data-row] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-s);
    padding-block: var(--space-xs);

    /* The first row shown in a group has no line over it: the group's
       own rule is there. `+` would count the rows a filter hid. */
    &:not([hidden]) ~ [data-row] {
      border-block-start: var(--hairline) solid var(--border);
    }
  }

  .what {
    p:first-child {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: var(--space-2xs);
    }

    a {
      text-decoration-line: none;

      &:hover {
        text-decoration-line: underline;
      }
    }

    b {
      display: inline-block;
      font-weight: var(--font-weight-medium);
    }

    :is(code, small) {
      font-size: var(--step--2);
      color: var(--muted-foreground);
    }

    p:last-child {
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  [data-stopped] b {
    color: var(--muted-foreground);
  }

  /* Where it answers: the addresses set flush right, so their dots fall
     in one column down the ledger's edge. */
  .where {
    display: grid;
    align-content: start;
    justify-items: end;
    font-family: var(--font-mono);
    font-feature-settings: normal;
    font-size: var(--step--2);
    /* One line of the name beside it. */
    line-height: calc(1.5 * var(--step-0));

    a {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2xs);
      letter-spacing: 0;
      color: var(--muted-foreground);

      &:hover {
        color: var(--foreground);
      }
    }
  }

  [data-empty] {
    padding-block: var(--space-xs);
    font-size: var(--step--1);
    color: var(--muted-foreground);
    border-block-start: var(--hairline) solid var(--border-strong);
  }

  /* On a phone the host heads its group instead of standing beside it,
     and a row's addresses drop under what they belong to. */
  @container (width < 30rem) {
    section {
      grid-template-columns: minmax(0, 1fr);
    }

    header {
      position: static;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: var(--space-xs);
      border-block-end: var(--hairline) solid var(--border);

      ul {
        display: flex;
        flex-wrap: wrap;
        column-gap: var(--space-xs);
      }
    }

    [data-row] {
      grid-template-columns: minmax(0, 1fr);
    }

    .where {
      justify-items: start;
      line-height: 1.75;

      a {
        flex-direction: row-reverse;
      }
    }
  }
</style>
