// homelab.lkwplus.com: the built page as static assets, plus one Worker
// route, /api/status, that asks every service whether it answers.
// Cloudflare Workers Builds runs `bun run build`, then `npx wrangler deploy`,
// with this folder as the root directory.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homelab",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "homelab.lkwplus.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Everything but the API is served straight from the assets, without
    // waking the Worker.
    "run_worker_first": ["/api/*"]
  }
}
